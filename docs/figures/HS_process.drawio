            <mxPoint x="129.5" y="470" as="sourcePoint" />
            <mxPoint x="130" y="960" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DpFGKTUfXO-kzDj_pGMA-2" value="&lt;p style=&quot;line-height: 100%;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Three &#39;referees&#39; have been assigned for each&amp;nbsp;issue,&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: initial; font-size: 11px;&quot;&gt;one in-person and two online,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial; font-size: 11px;&quot;&gt;&#39;referees&#39; cannot be the supplier of the issue and/or have disproportionate expertise in the topic. &#39;referees&#39; were required to research further about their assigned issue for the workshop&lt;/span&gt;&lt;/p&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="390" y="720" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="DpFGKTUfXO-kzDj_pGMA-4" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;Honourable mentions were selected based on very high neglected scores and/or very low &#39;heard of&#39; issues that &lt;br&gt;did not make into the shortlist&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="390" y="585" width="210" height="75" as="geometry" />
        </mxCell>
